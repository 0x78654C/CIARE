<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows8.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- The payload fixture exercises both CIARE_v3.2.3 and CIARE_v3.2.3.1 ZIP names. -->
    <Version>3.2.3.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UpdateCleanup\UpdateCleanup.csproj" />
    <Compile Include="..\CIARE\Updating\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\AutoUpdater\PackageInstaller.cs" Link="PackageInstaller.cs" />
    <Compile Include="..\AutoUpdater\UpdateOptions.cs" Link="UpdateOptions.cs" />
    <Compile Include="..\AutoUpdater\UpdaterForm.cs" Link="UpdaterForm.cs" />
  </ItemGroup>
</Project>
